<!DOCTYPE html>
<html lang="en" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= typeof title !=='undefined' ? title : 'EduManage' %>
    </title>

    <!-- Tailwind CDN + config -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            navy: '#0B0F19',
                            slate: '#1E293B',
                            violet: '#8B5CF6',
                            cyan: '#06B6D4'
                        }
                    },
                    boxShadow: {
                        'glow-violet': '0 0 20px -5px rgba(139, 92, 246, 0.5)',
                        'glow-cyan': '0 0 20px -5px rgba(6, 182, 212, 0.5)'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <!-- Icons, Charts, Toasts -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

    <style>
        html,
        body {
            font-family: 'Inter', sans-serif;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #0B0F19;
        }

        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #8B5CF6;
        }
    </style>
</head>

<body
    class="bg-brand-navy text-gray-300 antialiased flex h-screen overflow-hidden selection:bg-brand-violet selection:text-white">

    <!-- Global loader (progress bar + full-screen overlay) -->
    <%- include('../partials/loader') %>

        <!-- Sidebar -->
        <%- include('../partials/sidebar') %>

            <!-- Main Content Column -->
            <div class="flex-1 flex flex-col h-screen overflow-hidden min-w-0">

                <!-- Topbar -->
                <%- include('../partials/topbar') %>

                    <!-- Scrollable Page Content -->
                    <main class="flex-1 overflow-x-hidden overflow-y-auto bg-brand-navy p-4 md:p-6">
                        <%- typeof body !=='undefined' ? body : '<p class="text-gray-500">No content</p>' %>
                    </main>
            </div>

            <!-- Loader controller scripts -->
            <%- include('../partials/loader-scripts') %>

                <!-- Global Scripts -->
                <script>
                    // Icons
                    if (window.lucide) {
                        lucide.createIcons();
                    }

                    // SweetAlert2 Toast
                    const Toast = (window.Swal) ? Swal.mixin({
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3500,
                        timerProgressBar: true,
                        background: '#1E293B',
                        color: '#F8FAFC',
                        didOpen: function (toast) {
                            toast.addEventListener('mouseenter', Swal.stopTimer);
                            toast.addEventListener('mouseleave', Swal.resumeTimer);
                        }
                    }) : null;

                    // Safe flash rendering — never crashes on undefined
                    (function renderFlash() {
                        if (!Toast) return;

                        function firstMessage(name) {
                            var value;
                            try {
                                value = locals[name];
                            } catch (e) {
                                value = undefined;
                            }
                            if (!value) return null;
                            if (Array.isArray(value)) return value.length > 0 ? value[0] : null;
                            if (typeof value === 'string') return value.length > 0 ? value : null;
                            return null;
                        }

                        var success = firstMessage('success_msg');
                        var error = firstMessage('error_msg');

                        if (success) Toast.fire({ icon: 'success', title: success });
                        if (error) Toast.fire({ icon: 'error', title: error });
                    })();

                    // Auto-dismiss mobile sidebar when a link is clicked
                    document.addEventListener('click', function (e) {
                        var link = e.target.closest('a');
                        if (!link) return;
                        var mobileSidebar = document.getElementById('mobileSidebar');
                        if (mobileSidebar && !mobileSidebar.classList.contains('hidden')) {
                            if (link.closest('#mobileSidebar')) {
                                mobileSidebar.classList.add('hidden');
                            }
                        }
                    });
                </script>

                <!-- Page-specific scripts (optional; page can inject via `script` variable) -->
                <%- typeof script !=='undefined' ? script : '' %>
</body>

</html>