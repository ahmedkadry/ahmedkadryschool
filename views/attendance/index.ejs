<div class="mb-6">
    <h2 class="text-2xl font-bold text-white">Attendance</h2>
    <p class="text-gray-400 text-sm">Select a course and date to take or review attendance</p>
</div>

<div class="bg-brand-slate rounded-2xl border border-gray-800 p-6 md:p-8 max-w-2xl">
    <form action="/attendance/mark" method="GET" class="space-y-5">

        <div>
            <label class="block text-sm text-gray-300 mb-1">Course *</label>
            <select name="course" required
                class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet">
                <option value="">Select course</option>
                <% for (const c of courses) { %>
                    <option value="<%= c.id %>" <%=String(selectedCourse)===String(c.id) ? 'selected' : '' %>>
                        <%= c.course_code %> — <%= c.name %> (<%= c.teacher_name || 'Unassigned' %>)
                    </option>
                    <% } %>
            </select>
        </div>

        <div>
            <label class="block text-sm text-gray-300 mb-1">Date *</label>
            <input type="date" name="date" required value="<%= new Date().toISOString().split('T')[0] %>"
                class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet [color-scheme:dark]">
        </div>

        <div class="flex gap-4">
            <button type="submit"
                class="bg-brand-violet hover:bg-violet-600 text-white px-6 py-2.5 rounded-lg font-medium shadow-glow-violet flex-1">
                Take Attendance
            </button>
            <a href="/attendance/reports"
                class="bg-gray-800 hover:bg-gray-700 text-white px-6 py-2.5 rounded-lg font-medium border border-gray-700">
                View Reports
            </a>
        </div>
    </form>
</div>