<div class="mb-6">
    <a href="/students" class="text-gray-400 hover:text-white flex items-center gap-2 text-sm mb-2">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Students
    </a>
    <h2 class="text-2xl font-bold text-white">
        <%= student ? 'Edit Student' : 'Add New Student' %>
    </h2>
    <p class="text-gray-400 text-sm">Fill in the details below to <%= student ? 'update the' : 'create a new' %> student
            record.</p>
</div>

<div class="bg-brand-slate rounded-2xl border border-gray-800 shadow-lg p-6 md:p-8 max-w-4xl">
    <form action="<%= action %>" method="POST" enctype="multipart/form-data" class="space-y-6">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm text-gray-300 mb-1">First Name *</label>
                <input type="text" name="first_name" required value="<%= student ? student.first_name : '' %>"
                    class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet">
            </div>
            <div>
                <label class="block text-sm text-gray-300 mb-1">Last Name *</label>
                <input type="text" name="last_name" required value="<%= student ? student.last_name : '' %>"
                    class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet">
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm text-gray-300 mb-1">Gender *</label>
                <select name="gender" required
                    class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet">
                    <option value="Male" <%=student && student.gender==='Male' ? 'selected' : '' %>>Male</option>
                    <option value="Female" <%=student && student.gender==='Female' ? 'selected' : '' %>>Female</option>
                    <option value="Other" <%=student && student.gender==='Other' ? 'selected' : '' %>>Other</option>
                </select>
            </div>
            <div>
                <label class="block text-sm text-gray-300 mb-1">Date of Birth *</label>
                <input type="date" name="dob" required
                    value="<%= student && student.dob ? new Date(student.dob).toISOString().split('T')[0] : '' %>"
                    class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet [color-scheme:dark]">
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm text-gray-300 mb-1">Phone Number</label>
                <input type="text" name="phone" value="<%= student && student.phone ? student.phone : '' %>"
                    class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet">
            </div>
            <div>
                <label class="block text-sm text-gray-300 mb-1">Enrollment Date *</label>
                <input type="date" name="enrollment_date" required
                    value="<%= student ? new Date(student.enrollment_date).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>"
                    class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet [color-scheme:dark]">
            </div>
        </div>

        <div>
            <label class="block text-sm text-gray-300 mb-1">Address</label>
            <textarea name="address" rows="3"
                class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet"><%= student && student.address ? student.address : '' %></textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 border-t border-gray-800 pt-6">
            <div>
                <label class="block text-sm text-gray-300 mb-1">Guardian Name</label>
                <input type="text" name="guardian_name"
                    value="<%= student && student.guardian_name ? student.guardian_name : '' %>"
                    class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet">
            </div>
            <div>
                <label class="block text-sm text-gray-300 mb-1">Guardian Phone</label>
                <input type="text" name="guardian_phone"
                    value="<%= student && student.guardian_phone ? student.guardian_phone : '' %>"
                    class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet">
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 border-t border-gray-800 pt-6">
            <div>
                <label class="block text-sm text-gray-300 mb-1">Status</label>
                <select name="status"
                    class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet">
                    <option value="Active" <%=student && student.status==='Active' ? 'selected' : '' %>>Active</option>
                    <option value="Inactive" <%=student && student.status==='Inactive' ? 'selected' : '' %>>Inactive
                    </option>
                    <option value="Graduated" <%=student && student.status==='Graduated' ? 'selected' : '' %>>Graduated
                    </option>
                </select>
            </div>
            <div>
                <label class="block text-sm text-gray-300 mb-1">Profile Photo</label>
                <input type="file" name="profile_photo" accept="image/jpeg, image/png, image/webp"
                    class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-brand-violet file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-brand-violet/20 file:text-brand-violet hover:file:bg-brand-violet/30">
                <% if (student && student.profile_photo && student.profile_photo !=='default-avatar.png' ) { %>
                    <p class="text-xs text-gray-500 mt-2">Current: <%= student.profile_photo %>
                    </p>
                    <% } %>
            </div>
        </div>

        <div class="flex justify-end gap-4 border-t border-gray-800 pt-6">
            <a href="/students"
                class="px-6 py-2.5 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition-colors">Cancel</a>
            <button type="submit"
                class="bg-brand-violet hover:bg-violet-600 text-white px-6 py-2.5 rounded-lg font-medium transition-colors shadow-glow-violet">
                <%= student ? 'Update Student' : 'Save Student' %>
            </button>
        </div>
    </form>
</div>