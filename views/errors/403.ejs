<!DOCTYPE html>
<html lang="en" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: { extend: { colors: { brand: { navy: '#0B0F19', slate: '#1E293B', violet: '#8B5CF6', cyan: '#06B6D4' } } } }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>

<body class="bg-brand-navy min-h-screen flex items-center justify-center p-4 text-gray-300">

    <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-red-500/20 blur-[120px] rounded-full pointer-events-none">
    </div>

    <div
        class="w-full max-w-md bg-brand-slate border border-gray-700 rounded-2xl p-8 shadow-2xl relative z-10 text-center">
        <div class="w-16 h-16 mx-auto bg-red-500/20 rounded-full flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 15v2m0 0v2m0-2h2m-2 0H10m2-6V9a4 4 0 00-8 0v2a2 2 0 00-2 2v6a2 2 0 002 2h12a2 2 0 002-2v-6a2 2 0 00-2-2H6" />
            </svg>
        </div>

        <h1 class="text-2xl font-bold text-white mb-2">Access Denied</h1>
        <p class="text-gray-400 text-sm mb-6">
            You don't have permission to view this page. This area requires one of the following roles:
        </p>

        <div class="flex flex-wrap gap-2 justify-center mb-8">
            <% requiredRoles.forEach(role=> { %>
                <span
                    class="px-3 py-1 bg-red-500/10 text-red-400 border border-red-500/20 rounded-full text-xs font-medium">
                    <%= role %>
                </span>
                <% }); %>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/dashboard"
                class="bg-brand-violet hover:bg-violet-600 text-white px-6 py-2.5 rounded-lg font-medium transition-colors">
                Go to Dashboard
            </a>
            <a href="/logout"
                class="bg-gray-800 hover:bg-gray-700 text-white px-6 py-2.5 rounded-lg font-medium transition-colors border border-gray-700">
                Logout
            </a>
        </div>

        <% if (user) { %>
            <p class="text-xs text-gray-500 mt-6">
                Logged in as <strong class="text-gray-400">
                    <%= user.email %>
                </strong> (<%= user.role %>)
            </p>
            <% } %>
    </div>
</body>

</html>