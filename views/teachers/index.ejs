<div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <div>
        <h2 class="text-2xl font-bold text-white">Teachers</h2>
        <p class="text-gray-400 text-sm">Manage teaching staff</p>
    </div>
    <a href="/teachers/create"
        class="bg-brand-violet hover:bg-violet-600 text-white px-4 py-2 rounded-lg font-medium flex items-center gap-2">
        <i data-lucide="plus" class="w-4 h-4"></i> Add Teacher
    </a>
</div>

<div class="bg-brand-slate rounded-2xl border border-gray-800 shadow-lg overflow-hidden">

    <div class="p-4 border-b border-gray-800 bg-brand-slate/50">
        <form action="/teachers" method="GET" class="flex gap-2 max-w-md">
            <div class="relative flex-1">
                <i data-lucide="search" class="absolute left-3 top-2.5 text-gray-500 w-4 h-4"></i>
                <input type="text" name="search" value="<%= search || '' %>" placeholder="Search teachers..."
                    class="w-full bg-brand-navy border border-gray-700 rounded-lg pl-10 pr-4 py-2 text-sm text-white focus:outline-none focus:border-brand-violet">
            </div>
            <button class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg text-sm">Search</button>
        </form>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-400">
            <thead class="text-xs uppercase bg-brand-navy/50 border-b border-gray-800">
                <tr>
                    <th class="px-6 py-4">Name</th>
                    <th class="px-6 py-4">ID Code</th>
                    <th class="px-6 py-4">Email</th>
                    <th class="px-6 py-4">Department</th>
                    <th class="px-6 py-4">Status</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-800">
                <% if (!teachers || teachers.length===0) { %>
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-500">No teachers found.</td>
                    </tr>
                    <% } else { %>
                        <% for (const t of teachers) { %>
                            <% let badgeClass='bg-red-500/10 text-red-400' ; if (t.status==='Active' )
                                badgeClass='bg-green-500/10 text-green-400' ; %>
                                <tr class="hover:bg-brand-navy/30">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div
                                                class="w-10 h-10 rounded-full bg-brand-violet/20 flex items-center justify-center text-brand-violet font-bold">
                                                <%= t.first_name.charAt(0) %>
                                                    <%= t.last_name.charAt(0) %>
                                            </div>
                                            <div>
                                                <div class="font-medium text-white">
                                                    <%= t.first_name %>
                                                        <%= t.last_name %>
                                                </div>
                                                <div class="text-xs text-gray-500">
                                                    <%= t.specialization || 'General' %>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 font-mono text-brand-cyan">
                                        <%= t.teacher_id_code %>
                                    </td>
                                    <td class="px-6 py-4">
                                        <%= t.email %>
                                    </td>
                                    <td class="px-6 py-4">
                                        <%= t.department_name || '—' %>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-2.5 py-1 rounded-full text-xs font-medium <%= badgeClass %>">
                                            <%= t.status %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <a href="/teachers/edit/<%= t.id %>"
                                            class="text-gray-400 hover:text-brand-violet mr-3"><i data-lucide="edit"
                                                class="w-4 h-4 inline"></i></a>
                                        <button onclick="confirmDelete(<%= t.id %>)"
                                            class="text-gray-400 hover:text-red-500"><i data-lucide="trash-2"
                                                class="w-4 h-4 inline"></i></button>
                                    </td>
                                </tr>
                                <% } %>
                                    <% } %>
            </tbody>
        </table>
    </div>

    <div class="p-4 border-t border-gray-800 flex justify-between bg-brand-slate/50">
        <span class="text-sm text-gray-400">Page <%= currentPage %> of <%= totalPages || 1 %></span>
        <div class="flex gap-2">
            <% if (currentPage> 1) { %>
                <a href="/teachers?page=<%= currentPage - 1 %>&search=<%= search || '' %>"
                    class="px-3 py-1 bg-brand-navy border border-gray-700 rounded text-white text-sm hover:bg-gray-700">Previous</a>
                <% } %>
                    <% if (currentPage < totalPages) { %>
                        <a href="/teachers?page=<%= currentPage + 1 %>&search=<%= search || '' %>"
                            class="px-3 py-1 bg-brand-navy border border-gray-700 rounded text-white text-sm hover:bg-gray-700">Next</a>
                        <% } %>
        </div>
    </div>
</div>

<script>
    function confirmDelete(id) {
        Swal.fire({
            title: 'Archive teacher?',
            text: 'They will lose login access.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#EF4444',
            cancelButtonColor: '#334155',
            confirmButtonText: 'Yes, archive it!',
            background: '#1E293B',
            color: '#F8FAFC'
        }).then((r) => {
            if (r.isConfirmed) window.location.href = '/teachers/delete/' + id;
        });
    }
</script>